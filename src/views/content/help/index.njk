{% extends "template.njk" %}

{% set pageTitle = "Help and support - HMCTS API Marketplace - GOV.UK" %}
{% set section = "help" %}
{% set breadcrumbs = [{ text: "Home", href: "/" }] %}

{% block content %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    <h1 class="govuk-heading-xl">Help and support</h1>

    <p class="govuk-body-l">
      Get help at any point in your project, to make sure your integration with our APIs goes smoothly.
    </p>

    <h2 class="govuk-heading-l" id="contact">Contact the marketplace team</h2>

    <p class="govuk-body">
      Email
      <a class="govuk-link" href="mailto:APIMarketplace@hmcts.net">APIMarketplace@hmcts.net</a>
      for help connecting to our APIs, or to get started with onboarding.
    </p>

    <p class="govuk-body">
      To help us find the person best placed to support you, tell us:
    </p>

    <ul class="govuk-list govuk-list--bullet">
      <li>who you are and what you do</li>
      <li>what organisation you represent</li>
      <li>what you are trying to achieve</li>
      <li>which APIs you are using, or interested in</li>
    </ul>

    <h2 class="govuk-heading-l" id="feedback">Give us feedback</h2>

    <p class="govuk-body">
      This service is in beta and we are actively improving it. You can give feedback at any time,
      including suggesting APIs or capabilities you would like to see added.
    </p>

    <p class="govuk-body">
      If you would like to help us user-test the marketplace as we develop it, get in touch and say so
      &mdash; that is more useful to us than almost anything else.
    </p>

    <h2 class="govuk-heading-l" id="before">Before you get in touch</h2>

    <ul class="govuk-list">
      <li><a class="govuk-link" href="/api-catalogue">Browse the API catalogue</a> to check whether the API you need already exists</li>
      <li><a class="govuk-link" href="/documentation/consumer-guidance">Consumer guidance</a> covers rate limits, error handling and responsible use</li>
      <li><a class="govuk-link" href="/documentation/producer-guidance">Producer guidance</a> if you own an API and want it listed</li>
    </ul>

  </div>
</div>

{% endblock %}
