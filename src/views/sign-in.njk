{% extends "template.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

{% set pageTitle = "Sign in - HMCTS API Marketplace - GOV.UK" %}
{% set breadcrumbs = [{ text: "Home", href: "/" }] %}

{# The real service sends people to Microsoft Entra here. This prototype signs in the
   same fixed user the service's own BYPASS_ENTRA mode uses, with no network call. #}
{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-xl">Sign in</h1>

    {{ govukInsetText({
      text: "This is a prototype. There is no real sign-in: it signs you in as a fixed example user so the signed-in pages can be demonstrated."
    }) }}

    <p class="govuk-body">You will be signed in as <strong>John Doe</strong> (john.doe@example.com).</p>

    {{ govukButton({
      text: "Sign in as the example user",
      href: "../account/",
      attributes: { id: "sign-in", "data-action": "sign-in" }
    }) }}
  </div>
</div>
{% endblock %}
