{% extends "template.njk" %}

{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% set pageTitle = "Production credentials request " + request.reference + " - HMCTS API Marketplace - GOV.UK" %}
{% set section = "account" %}
{% set breadcrumbs = [
  { text: "Home", href: "/" },
  { text: "Your account", href: "/account" }
] %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <span class="govuk-caption-l">Production credentials request</span>
    <h1 class="govuk-heading-xl" id="request-reference">{{ request.reference }}</h1>

    <p class="govuk-body">
      Status: {{ govukTag({ text: status, classes: "govuk-tag--blue", attributes: { id: "request-status" } }) }}
      <br>Submitted <span id="request-submitted">{{ request.submittedAt | date }}</span>
    </p>

    {% set summaryRows = [] %}
    {% for row in rows %}
      {% set summaryRows = (summaryRows.push({ key: { text: row.key }, value: { text: row.value } }), summaryRows) %}
    {% endfor %}
    {{ govukSummaryList({ rows: summaryRows, attributes: { id: "request-answers" } }) }}

    <p class="govuk-body"><a class="govuk-link" href="/account#tab-requests">Back to My requests</a></p>
  </div>
</div>
{% endblock %}
