{% extends "template.njk" %}

{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/date-input/macro.njk" import govukDateInput %}
{% from "govuk/components/character-count/macro.njk" import govukCharacterCount %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "macros/errors.njk" import errorSummary %}

{% set pageTitle = ("Error: " if errors.length) + "Request production credentials - HMCTS API Marketplace - GOV.UK" %}
{% set section = "applications" %}
{% set breadcrumbs = [
  { text: "Home", href: "/" },
  { text: "Your account", href: "/account" },
  { text: "Manage applications", href: "/account/applications" }
] %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {{ errorSummary(errors) }}

    <h1 class="govuk-heading-xl">Request production credentials</h1>

    <p class="govuk-body">
      Production credentials let your application call our APIs with live data. The marketplace team reviews
      every request, then creates the client ID, secret and subscription keys and sends them to you securely.
    </p>

    {% if not applicationItems.length %}
      <p class="govuk-body" id="no-applications">
        You need an application that has been tested in the sandbox first.
        <a class="govuk-link" href="/account/applications/new">Create an application</a>.
      </p>
    {% else %}

    <form method="post" action="/account/production-credentials" novalidate>

      {{ govukRadios({
        name: "application",
        fieldset: { legend: { text: "Which application is going live?", classes: "govuk-fieldset__legend--m" } },
        hint: { text: "Production credentials cover the same APIs as the application you choose." },
        items: applicationItems,
        value: answers.application,
        errorMessage: { text: errorFor.application } if errorFor.application
      }) }}

      {{ govukInput({
        label: { text: "Organisation or team name", classes: "govuk-label--m" },
        id: "organisation",
        name: "organisation",
        value: answers.organisation,
        autocomplete: "organization",
        errorMessage: { text: errorFor.organisation } if errorFor.organisation
      }) }}

      {{ govukDateInput({
        id: "go-live",
        namePrefix: "go-live",
        fieldset: { legend: { text: "When do you plan to go live?", classes: "govuk-fieldset__legend--m" } },
        hint: { text: "For example, 27 3 2027" },
        errorMessage: { text: errorFor["go-live-day"] } if errorFor["go-live-day"],
        items: [
          { id: "go-live-day", name: "day", label: "Day", classes: "govuk-input--width-2" + (" govuk-input--error" if errorFor["go-live-day"]), value: answers["go-live-day"] },
          { id: "go-live-month", name: "month", label: "Month", classes: "govuk-input--width-2" + (" govuk-input--error" if errorFor["go-live-day"]), value: answers["go-live-month"] },
          { id: "go-live-year", name: "year", label: "Year", classes: "govuk-input--width-4" + (" govuk-input--error" if errorFor["go-live-day"]), value: answers["go-live-year"] }
        ]
      }) }}

      {{ govukRadios({
        name: "call-volume",
        fieldset: { legend: { text: "Expected call volume in production", classes: "govuk-fieldset__legend--m" } },
        items: callVolumes,
        value: answers["call-volume"],
        errorMessage: { text: errorFor["call-volume"] } if errorFor["call-volume"]
      }) }}

      {{ govukCharacterCount({
        label: { text: "Please provide a description of the data request, how you plan to use this data for each API selected in the above application, whether this data will be used in conjunction with any other data (if so, how), and an explanation of why this data is required.", classes: "govuk-label--m" },
        id: "data-request",
        name: "data-request",
        maxlength: dataAnswerMaxLength,
        value: answers["data-request"],
        errorMessage: { text: errorFor["data-request"] } if errorFor["data-request"]
      }) }}

      {{ govukCharacterCount({
        label: { text: "Please describe any proposed outputs from this data use for each API selected in the above application, including what the output aims to achieve, and how/where it will be shared.", classes: "govuk-label--m" },
        id: "proposed-outputs",
        name: "proposed-outputs",
        maxlength: dataAnswerMaxLength,
        value: answers["proposed-outputs"],
        errorMessage: { text: errorFor["proposed-outputs"] } if errorFor["proposed-outputs"]
      }) }}

      {{ govukButton({ text: "Continue", attributes: { id: "production-continue" } }) }}
    </form>
    {% endif %}

  </div>
</div>
{% endblock %}
