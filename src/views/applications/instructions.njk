{#- How to use this application's credentials with one API (i): the token request as a curl command, then a link to try the API in the developer portal. -#}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{{ govukSummaryList({
  rows: [
    { key: { text: "Publisher ID (scope)" }, value: { html: '<span class="apim-credential" id="publisher-id-' + i.apiName + '">' + (i.token.publisherId | escape) + '</span>' } }
  ]
}) }}

<h3 class="govuk-heading-s">Get an access token</h3>
<p class="govuk-body">Request a token from Microsoft Entra ID with the OAuth 2.0 client credentials flow:</p>
<pre class="apim-code" id="token-request-{{ i.apiName }}"><code>curl --request POST \
  --url {{ i.token.url }} \
  --header 'Content-Type: application/x-www-form-urlencoded' \
  --data grant_type=client_credentials \
  --data client_id={{ i.token.clientId }} \
  --data 'client_secret={{ i.token.clientSecret }}' \
  --data scope={{ i.token.scope }}</code></pre>

<h3 class="govuk-heading-s">Run try it now in developer portal</h3>
<p class="govuk-body"><a class="govuk-link" id="api-reference-{{ i.apiName }}" href="{{ i.docsUrl }}" rel="noreferrer noopener" target="_blank">{{ i.apiTitle }} API reference (opens in new tab)</a></p>
